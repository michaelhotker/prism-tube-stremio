{
  "name": "prism-tube-stremio",
  "version": "1.4.0",
  "private": true,
  "description": "Self-hosted Stremio catalogs and streams for configured tube sites and public X media feeds",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelhotker/prism-tube-stremio.git"
  },
  "bugs": {
    "url": "https://github.com/michaelhotker/prism-tube-stremio/issues"
  },
  "homepage": "https://github.com/michaelhotker/prism-tube-stremio#readme",
  "type": "module",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "check": "node --check src/server.js && node --test",
    "smoke:live": "node --env-file-if-exists=.env scripts/live-smoke.js"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "express": "4.22.3",
    "stremio-addon-sdk": "1.6.10",
    "youtube-dl-exec": "3.1.15"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "tmp": "0.2.7"
  },
  "license": "MIT"
}
