# Bind to localhost for private use. Use 0.0.0.0 inside Docker.
HOST=127.0.0.1
PORT=7000

# A comma-separated subset of: xvideos,homo,xhamster,xnxx
ENABLED_SOURCES=xvideos,homo,xhamster,xnxx

# Optional. If set, the manifest lives at /<token>/manifest.json.
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# ADDON_TOKEN=

REQUEST_TIMEOUT_MS=12000
EXTRACT_TIMEOUT_MS=25000
CACHE_TTL_SECONDS=300
MAX_CACHE_ENTRIES=500
MAX_RESULTS=60
MAX_STREAMS=4
SEARCH_CONCURRENCY=2

