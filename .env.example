# Bind to localhost for private use. Use 0.0.0.0 inside Docker.
HOST=127.0.0.1
PORT=7000

# A comma-separated subset of: xvideos,homo,xhamster,xnxx
ENABLED_SOURCES=xvideos,homo,xhamster,xnxx

# Optional automatic X media catalogs. One public account handle per comma.
# Each handle becomes a separate Porn catalog in Discover.
X_ACCOUNTS=

# RSSHub runs inside the Compose stack. Its X route uses the auth_token cookie
# value from your own X session. Keep this secret and never paste it into chat.
TWITTER_AUTH_TOKEN=
RSSHUB_URL=http://rsshub:1200

# Optional. If set, the manifest lives at /<token>/manifest.json.
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# ADDON_TOKEN=

REQUEST_TIMEOUT_MS=12000
EXTRACT_TIMEOUT_MS=25000
CACHE_TTL_SECONDS=300
MAX_CACHE_ENTRIES=500
MAX_RESULTS=60
MAX_STREAMS=4
SEARCH_CONCURRENCY=2
